#!/usr/bin/env bash
# guest-screens — look over the operator's shoulder during a hand run.
#
# While the factory's VirtualBox guest runs with a window (a hand run; a
# batch's headless guest is not recorded), save its screen every 2 s with
# VBoxManage screenshotpng (read-only: nothing is typed or clicked in the
# guest), and keep a frame only when it differs from the last one kept, so a
# session holds its unique screens in order. One directory per guest session
# under ~/data/vista-forge/cprs-screens/, named by its UTC start as
# v-factory's run directories are. Each holds NNNN-<UTC>.png frames and
# frames.tsv: seq, file, utc, the seconds since the session's start, and the
# seconds the screen was held (what a movie made from the frames replays).
#
# Usage: guest-screens [sessions] [hours]
#   sessions  guest sessions to record before stopping (default 2)
#   hours     stop after this long whatever happens (default 3)
#        guest-screens --install | --uninstall | --status
#   --install writes and starts a user service that records every hand run
#   from then on (guest-screens --service: no limit on sessions or hours,
#   waiting for the lock while a manual recorder runs), naming this script by
#   its path today; it restarts on a failure and stops after three in ten
#   minutes, so a broken recorder shows as failed, not as activity.
# Environment: GUEST_SCREENS_VM (default win10_x64, v-factory's guest),
#   GUEST_SCREENS_PIXELS (default 40: fewer changed pixels than this, at a 1 %
#   colour fuzz, count as the same screen, so a blinking caret adds nothing).
set -euo pipefail

vm=${GUEST_SCREENS_VM:-win10_x64}
pixels=${GUEST_SCREENS_PIXELS:-40}
root=$HOME/data/vista-forge/cprs-screens
unitfile=$HOME/.config/systemd/user/guest-screens.service
mkdir -p "$root"

# unit SELF: the user service's unit, running SELF as the recorder.
unit() {
	cat <<UNIT
[Unit]
Description=guest-screens: the factory guest's unique screens during each hand run (a guest with a window only; one recorder at a time)
StartLimitIntervalSec=600
StartLimitBurst=3

[Service]
ExecStart=$1 --service
Restart=on-failure
RestartSec=30

[Install]
WantedBy=default.target
UNIT
}

running() { VBoxManage list runningvms 2>/dev/null | grep -q "\"$vm\""; }

# windowed: the guest runs with a window, as a hand run starts it. A
# v-factory batch starts it headless, and its runs are not recorded
# (2026-10-13: a batch was recorded as a session).
windowed() {
	running && ! VBoxManage showvminfo "$vm" --machinereadable 2>/dev/null | grep -q '^SessionName="headless"'
}

# changed A B: true when B differs from A by at least $pixels pixels.
changed() {
	local n
	n=$(compare -metric AE -fuzz 1% "$1" "$2" null: 2>&1 >/dev/null || true)
	awk -v n="$n" -v p="$pixels" 'BEGIN { exit !(n + 0 >= p) }'
}

# finish DIR END: fill frames.tsv's held column from each frame to the next.
finish() {
	local dir=$1 end=$2 tmp
	[ -f "$dir/frames.tsv" ] || return 0
	tmp=$(mktemp)
	awk -F'\t' -v OFS='\t' -v end="$end" '
		NR == 1 { print $1, $2, $3, $4, "held_s"; next }
		{ row[NR] = $0; t[NR] = $4; last = NR }
		END {
			for (i = 2; i <= last; i++) {
				nxt = (i < last) ? t[i + 1] : end
				print row[i], nxt - t[i]
			}
		}' "$dir/frames.tsv" >"$tmp"
	mv "$tmp" "$dir/frames.tsv"
	echo "session ended: $(($(wc -l <"$dir/frames.tsv") - 1)) frames in $dir"
}

# Sourced (by a test), stop here: the functions above are defined.
(return 0 2>/dev/null) && return 0

service=""
case "${1:-}" in
--install)
	self=$(readlink -f "${BASH_SOURCE[0]}")
	mkdir -p "$(dirname "$unitfile")"
	unit "$self" >"$unitfile"
	systemctl --user daemon-reload
	systemctl --user enable --now guest-screens.service
	echo "guest-screens: installed $unitfile, running $self --service"
	exit 0
	;;
--uninstall)
	systemctl --user disable --now guest-screens.service 2>/dev/null || true
	rm -f "$unitfile"
	systemctl --user daemon-reload
	echo "guest-screens: uninstalled"
	exit 0
	;;
--status)
	echo "service: $(systemctl --user is-active guest-screens.service 2>/dev/null || true)"
	if [ -f "$unitfile" ]; then grep '^ExecStart=' "$unitfile"; else echo "no unit at $unitfile"; fi
	last=$(find "$root" -mindepth 1 -maxdepth 1 -type d -name '2*' | sort | tail -1)
	echo "last session: ${last:-none}"
	exit 0
	;;
--service) service=1 want=0 hours=0 ;;
*) want=${1:-2} hours=${2:-3} ;;
esac

# One recorder at a time: a second writes a second folder of the same
# frames (2026-10-13: two recorders from two sessions recorded one run).
# The service waits for a manual recorder to finish rather than fail.
exec 9>"$root/.lock"
if [ -n "$service" ]; then
	flock 9
elif ! flock -n 9; then
	echo "guest-screens: another recorder is running (the service, if installed: guest-screens --status); not starting a second" >&2
	exit 1
fi

dir="" start=0 seq=0 kept="" sessions=0
trap '[ -n "$dir" ] && finish "$dir" $(($(date +%s) - start)); exit 0' INT TERM
deadline=0 # none
[ "$hours" -gt 0 ] && deadline=$(($(date +%s) + hours * 3600))

while [ "$deadline" -eq 0 ] || [ "$(date +%s)" -lt "$deadline" ]; do
	if windowed; then
		now=$(date +%s)
		if [ -z "$dir" ]; then
			dir=$root/$(date -u +%Y%m%dT%H%M%SZ)
			mkdir -p "$dir"
			printf 'seq\tfile\tutc\tt_s\n' >"$dir/frames.tsv"
			start=$now seq=0 kept=""
			echo "session $((sessions + 1)) started: $dir"
		fi
		utc=$(date -u +%Y%m%dT%H%M%SZ)
		f=$dir/next.png
		if VBoxManage controlvm "$vm" screenshotpng "$f" >/dev/null 2>&1; then
			if [ -z "$kept" ] || changed "$kept" "$f"; then
				seq=$((seq + 1))
				name=$(printf '%04d-%s.png' "$seq" "$utc")
				mv "$f" "$dir/$name"
				kept=$dir/$name
				printf '%d\t%s\t%s\t%d\n' "$seq" "$name" "$utc" $((now - start)) >>"$dir/frames.tsv"
			else
				rm -f "$f"
			fi
		fi
		sleep $((2 - ($(date +%s) - now) > 0 ? 2 - ($(date +%s) - now) : 0))
	else
		if [ -n "$dir" ]; then
			finish "$dir" $(($(date +%s) - start))
			dir=""
			sessions=$((sessions + 1))
			[ "$want" -gt 0 ] && [ "$sessions" -ge "$want" ] && exit 0
		fi
		sleep 3
	fi
done
[ -n "$dir" ] && finish "$dir" $(($(date +%s) - start))
echo "stopped at the ${hours} h bound after $sessions session(s)"
