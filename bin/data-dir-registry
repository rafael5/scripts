#!/usr/bin/env bash
# =============================================================================
#  data-dir-registry
#  Version: 1.0.0
#  Target:  minty — Linux Mint 22.3 / Ubuntu 24.04, bash 5.x, run as rafael
#
#  Purpose
#  ~/data holds the persistent, never-committed working data. Nothing described
#  what lived there or how big it had got. This generates that inventory into
#  ~/data/data-dir-registry.md.
#
#  It is a GENERATOR, deliberately. ~/scripts/FILESYSTEM.md was retired on
#  2026-07-25 for being a hand-maintained snapshot (~70% accurate, no generator,
#  no checker) — a registry with no way to regenerate itself rots into exactly
#  that. Re-run this instead of editing the table by hand.
#
#  Usage: data-dir-registry [--check]
#    (no args)  Regenerate ~/data/data-dir-registry.md
#    --check    Report whether the file is out of date; exit 1 if it is.
#               Changes nothing. Suitable for cron.
#
#  Measurement notes (the table repeats these; they are the reading of record)
#    - Subdirs/Files are RECURSIVE counts below the entry, excluding itself.
#    - Size is du(1) disk usage, not apparent size.
#    - Last updated is the newest mtime anywhere in the subtree.
#    - Symlinks are named, never followed — no entry is counted twice.
#    - A subtree this user cannot read is counted as far as it goes and the row
#      says so. No silent partial: an unreadable path is disclosed, never
#      rounded away.
# =============================================================================
set -uo pipefail

DATA_ROOT="${DATA_ROOT:-$HOME/data}"
OUT="$DATA_ROOT/data-dir-registry.md"

# render — write the registry markdown to stdout.
render() {
  local total_bytes=0 total_dirs=0 total_files=0 rows=""

  local e denied subdirs files bytes size_h newest newest_d note
  while IFS= read -r e; do
    if [ -L "$e" ]; then
      local tgt; tgt="$(readlink -f "$e")"
      rows+="| \`$e\` | — | — | — | — | symlink → \`~/${tgt#"$HOME"/}\` |"$'\n'
      continue
    fi
    if [ ! -d "$e" ]; then
      continue   # plain files at the root (this registry itself) are not rows
    fi

    denied="$(find "$e" ! -readable -print 2>/dev/null | wc -l)"
    subdirs="$(find "$e" -mindepth 1 -type d 2>/dev/null | wc -l)"
    files="$(find "$e" -mindepth 1 -type f 2>/dev/null | wc -l)"
    bytes="$(du -sb "$e" 2>/dev/null | cut -f1)"; bytes="${bytes:-0}"
    size_h="$(numfmt --to=iec --suffix=B "$bytes")"
    newest="$(find "$e" -printf '%T@\n' 2>/dev/null | sort -rn | head -1)"
    newest_d="$(date -d "@${newest%.*}" +%Y-%m-%d 2>/dev/null || echo '—')"

    note=""
    [ "$denied" -gt 0 ] && note="partial — $denied unreadable path(s)"

    rows+="| \`$e\` | $subdirs | $files | $size_h | $newest_d | $note |"$'\n'
    total_bytes=$((total_bytes + bytes))
    total_dirs=$((total_dirs + subdirs))
    total_files=$((total_files + files))
  done < <(cd "$DATA_ROOT" && ls -1A | LC_ALL=C sort)

  cat <<EOF
# ~/data — directory registry

Persistent working data for this machine. **Not git controlled** — nothing here
is recoverable from a repo, which is what the minty backup covers.

Generated by \`data-dir-registry\` (in \`~/scripts/bin/\`) on $(date +%Y-%m-%d).
Re-run it after adding or retiring a directory; \`data-dir-registry --check\`
says whether this file has drifted. **Do not hand-edit the table.**

Subdirs and files are recursive counts below each entry. Size is \`du\` disk
usage. Last updated is the newest mtime anywhere in the subtree. Symlinks are
named, not followed, so nothing is counted twice.

| Directory | Subdirs | Files | Size | Last updated | Notes |
|---|---:|---:|---:|---|---|
${rows}| **total** | **$total_dirs** | **$total_files** | **$(numfmt --to=iec --suffix=B "$total_bytes")** | | symlink excluded |
EOF
}

main() {
  case "${1:-}" in
    --check)
      if [ ! -f "$OUT" ]; then
        echo "data-dir-registry: MISSING — $OUT does not exist; run: data-dir-registry"
        exit 1
      fi
      local tmp; tmp="$(mktemp)"; trap 'rm -f "$tmp"' EXIT
      render >"$tmp"
      # Ignore the generated-on line: a date change alone is not drift.
      if diff -q <(grep -v '^Generated by' "$OUT") <(grep -v '^Generated by' "$tmp") >/dev/null; then
        echo "data-dir-registry: current — $OUT matches ~/data"
        exit 0
      fi
      echo "data-dir-registry: STALE — ~/data has changed since $OUT was written"
      diff <(grep -v '^Generated by' "$OUT") <(grep -v '^Generated by' "$tmp") | sed 's/^/  /'
      echo "  remedy: data-dir-registry"
      exit 1
      ;;
    -h|--help)
      sed -n '2,28p' "$0" | sed 's/^# \{0,1\}//'
      exit 0
      ;;
    "")
      render >"$OUT" && echo "data-dir-registry: wrote $OUT"
      ;;
    *)
      echo "data-dir-registry: unknown argument '$1' (try --help)" >&2
      exit 2
      ;;
  esac
}

main "$@"
