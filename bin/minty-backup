#!/usr/bin/env bash
# =============================================================================
#  minty-backup
#  Version: 1.1.0
#  Target:  minty — Linux Mint 22.3 / Ubuntu 24.04, bash 5.x, run as root
#
#  Purpose
#  The nightly run of the minty backup design: BorgBackup of the whole machine
#  to the USB drive (Layer 1), then a versioned rclone copy of the curated
#  irreplaceable subset to cloud object storage (Layer 3).
#
#  Canon: ~/projects/minty/docs/minty-backup-proposal.md §4.1. Read it before
#  changing anything here; every guard below exists because its absence was a
#  measured silent-failure defect (§11.5).
#
#  Design — the failure mode this defends against is NOT data loss, it is a
#  green stamp over a broken backup:
#   1. Mount sentinel FIRST. fstab `nofail` means an absent drive still boots;
#      without this guard borg happily creates a repo inside the empty
#      mountpoint on the root filesystem, eats the free space, and stamps
#      green (§11.5 item 2). This is the single most important line here.
#   2. `borg info` must succeed before anything is written — catches a
#      mounted-but-corrupt or wrong drive.
#   3. Green-only stamping. Nothing is refreshed unless the whole phase
#      succeeded, so STALENESS is the alarm (minty-backup-watch reads it).
#      The borg and cloud phases stamp SEPARATELY, so a stale stamp says
#      which half failed.
#   4. Always exit 0. Cron has no reader; the stamp is the channel, not the
#      exit code — same discipline as engine-image-archive-cron.sh.
#
#   5. Warnings are not failures. borg exits rc=1 for "file changed while we
#      backed it up" — a COMPLETE archive with a note attached. Treating that as
#      failure made the 2026-08-04 first run report RED, skip its stamp and
#      never reach prune, over a perfectly good 2.9 M-file archive. Only rc>=2
#      is failure.
#   6. Quiesce, then restart under a trap. A live M/IRIS engine writing during
#      the copy is the CAUSE of those warnings, and the archived database file
#      is not one a restore could open. Engines stop for the borg phase; the
#      EXIT trap restarts them even on abort, and a failed restart alarms
#      immediately — the stamp cannot catch it, because the backup succeeded.
#
#  Phases
#   preflight()     sentinel, root, borg present, repo readable — hard abort
#   dump_meta()     restore metadata into the backup set (self-describing)
#   quiesce_down()  stop QUIESCE_CONTAINERS      (restart guaranteed by trap)
#   phase_borg()    create + prune (+ compact on Sundays) -> STAMP.borg
#   quiesce_up()    restart them; ntfy alarm if one does not come back
#   phase_cloud()   rclone copy of the curated subset     -> STAMP.rclone
#
#  Use
#    minty-backup                 nightly run (root cron, 23:00)
#    minty-backup --preflight     guards only; writes nothing, stamps nothing
#    minty-backup --sync-docs     refresh the drive's RECOVERY.txt/docs/scripts
#                                 only; writes no archive, stamps nothing
#    minty-backup --help
#
#  Config: /etc/minty-backup.env (root, 0600) — see the template in
#  ~/projects/minty/etc/minty-backup.env.example. It carries BORG_PASSPHRASE,
#  so it is the one file here that must never be world-readable.
#
#  Schedule (root crontab — `sudo crontab -e`):
#    0 23 * * *  /home/rafael/scripts/bin/minty-backup
#  23:00 is deliberate: ahead of the org's fully-booked, docker-heavy
#  01:00-05:45 block (proposal §7).
# =============================================================================
set -euo pipefail

CONFIG="${MINTY_BACKUP_CONFIG:-/etc/minty-backup.env}"

# ---- defaults (override in $CONFIG) -----------------------------------------
BORG_REPO="/mnt/minty-backup/borg"
SENTINEL="/mnt/minty-backup/.is-backup-vol"
STAMP_DIR="/var/lib/minty-backup"
META_DIR="/var/backups/minty-meta"
LOG="/var/log/minty-backup.log"
LOG_KEEP_LINES=20000
COMPACT_DOW=7                 # Sunday; compact rewrites segments, the one
                              # access pattern this DM-SMR drive dislikes (§1.3)
BORG_COMPRESSION="zstd,3"
KEEP_DAILY=7
KEEP_WEEKLY=4
KEEP_MONTHLY=6
CLOUD_REMOTE=""               # empty => cloud phase disabled (open decision D2)
CLOUD_BACKUP_DIR=""           # optional --backup-dir if the bucket has no versioning
CLOUD_PATHS=""                # newline-separated absolute paths
CLOUD_EXCLUDES=""             # newline-separated rclone --exclude patterns
QUIESCE_CONTAINERS=""         # space-separated containers stopped for the borg
                              # phase; empty => nothing is quiesced
QUIESCE_TIMEOUT=60            # seconds `docker stop` waits before SIGKILL
NTFY_ENV="/home/rafael/data/vista-forge/auth.env"   # absolute: root cron has
                              # HOME=/root, so ~/data would not resolve

usage() { sed -n '2,60p' "$0" | sed 's/^# \{0,1\}//'; }

case "${1:-}" in
  -h|--help) usage; exit 0 ;;
esac
PREFLIGHT_ONLY=0
SYNC_DOCS_ONLY=0
[ "${1:-}" = "--preflight" ] && PREFLIGHT_ONLY=1
[ "${1:-}" = "--sync-docs" ] && SYNC_DOCS_ONLY=1

# shellcheck source=/dev/null
if [ -r "$CONFIG" ]; then
  set -a; . "$CONFIG"; set +a
elif [ "$PREFLIGHT_ONLY" -eq 0 ]; then
  echo "minty-backup: FATAL — config $CONFIG missing or unreadable." >&2
  echo "  It carries BORG_PASSPHRASE; without it no run can succeed." >&2
  exit 1
else
  echo "  note: config $CONFIG not readable — checking defaults only"
fi

STAMP_BORG="$STAMP_DIR/STAMP.borg"
STAMP_CLOUD="$STAMP_DIR/STAMP.rclone"

# Exclude list — proposal §3 Layer 1. --one-file-system already skips the
# pseudo-filesystems and the vfat ESP; they stay listed so the intent survives
# a future flag change. /mnt and /media cover the repo's own mountpoint.
BORG_EXCLUDES=(
  --exclude '/proc'
  --exclude '/sys'
  --exclude '/dev'
  --exclude '/tmp'
  --exclude '/run'
  --exclude '/swapfile'
  --exclude '/var/lib/docker'     # rebuildable; the engine-image archive in
                                  # ~/data/vista-forge/images IS in the set (§7)
  --exclude '/var/lib/containerd' # the SAME state under the containerd store —
                                  # excluding only /var/lib/docker missed it, and
                                  # the 2026-08-04 first run proved it by warning
                                  # on a live vehu.dat inside an overlayfs
                                  # snapshot. One copy of each engine is enough,
                                  # and that copy is the image archive.
  --exclude '/timeshift'          # 35 G of rsync snapshots borg already versions
  --exclude '/home/rafael/.cache'
  --exclude '/root/.cache'        # borg's own cache — would recurse
  --exclude '/var/cache'
  --exclude '/mnt'
  --exclude '/media'
)

say() { printf '  %s\n' "$*"; }

# An abort IS a failed backup — the drive being unplugged is the likeliest one —
# and it writes no stamp, so staleness alone would not report it until the
# SECOND consecutive miss (see the borg-RED note in main). Alarm on the way out.
# Only as root, though: a non-root manual run is an operator typo, not an estate
# failure, and must not page the phone.
die() {
  printf '  ABORT: %s\n' "$*" >&2
  if [ "$(id -u)" -eq 0 ] && [ "${PREFLIGHT_ONLY:-0}" -eq 0 ] && [ "${SYNC_DOCS_ONLY:-0}" -eq 0 ]; then
    alarm "minty BACKUP ABORTED" \
"$(hostname) · $(date '+%Y-%m-%d %H:%M')
$*

Nothing was written and nothing was stamped.
Last 40 log lines: sudo tail -40 $LOG" || true
  fi
  exit 1
}

# ---- the drive must explain itself ------------------------------------------
# In a disaster the drive is the object someone is physically holding, possibly
# without this machine, this repo, or a network. So it carries the recovery
# card, the docs, and the scripts that wrote it — refreshed every run so they
# cannot drift from the design they describe.
#
# EVERY step here is `|| true`. A documentation copy must never be able to fail
# a backup: that would be a red stamp over a working archive, which is §11.5
# item 7 in a different costume.
DRIVE_ROOT="$(dirname "$SENTINEL")"
DOCS_SRC="${DOCS_SRC:-/home/rafael/projects/minty}"
SCRIPTS_SRC="${SCRIPTS_SRC:-/home/rafael/scripts}"

sync_drive_docs() {
  [ -d "$DRIVE_ROOT" ] || { say "drive docs: $DRIVE_ROOT absent — skipped"; return 0; }
  if [ ! -d "$DOCS_SRC/docs" ]; then
    say "drive docs: source $DOCS_SRC/docs absent — skipped (drive keeps its last copy)"
    return 0
  fi
  install -m 0644 "$DOCS_SRC/docs/drive/RECOVERY.txt" "$DRIVE_ROOT/RECOVERY.txt" 2>/dev/null || true
  mkdir -p "$DRIVE_ROOT/docs" "$DRIVE_ROOT/scripts" 2>/dev/null || true
  cp -f "$DOCS_SRC/docs"/*.md          "$DRIVE_ROOT/docs/"    2>/dev/null || true
  cp -f "$DOCS_SRC/README.md"          "$DRIVE_ROOT/docs/"    2>/dev/null || true
  cp -f "$SCRIPTS_SRC/minty-backup-guide.md" "$DRIVE_ROOT/docs/" 2>/dev/null || true
  # The automation itself, so a rebuilt machine can be re-armed from the drive.
  cp -f "$SCRIPTS_SRC/bin/minty-backup" "$SCRIPTS_SRC/bin/minty-backup-check" \
        "$SCRIPTS_SRC/bin/minty-backup-watch" "$SCRIPTS_SRC/bin/minty-backup-status" \
        "$DRIVE_ROOT/scripts/" 2>/dev/null || true
  # NOT the config: it holds BORG_PASSPHRASE, and the passphrase must never sit
  # on the drive it unlocks (§11.5 item 1, and RECOVERY.txt says so explicitly).
  say "drive docs refreshed — RECOVERY.txt, docs/, scripts/"
}

# ---- preflight ---------------------------------------------------------------
preflight() {
  # 1. Mount sentinel. Before anything else, and before root: an unmounted
  #    drive is the defect that stamps green over nothing (§11.5 item 2).
  [ -f "$SENTINEL" ] || die "sentinel $SENTINEL absent — the backup drive is NOT mounted. Nothing written, nothing stamped."
  say "sentinel present — $SENTINEL"

  [ "$(id -u)" -eq 0 ] || die "must run as root (backing up / and writing $STAMP_DIR)."
  command -v borg >/dev/null || die "borg not installed (apt install borgbackup; pin 1.2.x — §5.5)."
  say "borg $(borg --version | awk '{print $2}')"

  # 2. Repo readable? Catches mounted-but-corrupt and wrong-drive.
  borg info "$BORG_REPO" >/dev/null 2>&1 || die "borg info failed on $BORG_REPO — repo missing, corrupt, or wrong passphrase."
  say "repo readable — $BORG_REPO"

  if [ -n "$CLOUD_REMOTE" ]; then
    command -v rclone >/dev/null || die "CLOUD_REMOTE set but rclone not installed."
    say "cloud remote configured — $CLOUD_REMOTE"
  else
    say "cloud phase DISABLED (CLOUD_REMOTE empty — open decision D2)"
  fi
}

# ---- restore metadata (§4.1 step 3) -----------------------------------------
# Only what is NOT already recoverable from the filesystem itself. /etc/cron*
# and /etc/fstab come with /etc, but fstab is copied anyway: it is the single
# most-needed file during a bare-metal rebuild and the dump should be
# self-describing on its own.
dump_meta() {
  mkdir -p "$META_DIR"
  dpkg --get-selections            > "$META_DIR/dpkg-selections"
  apt-mark showmanual              > "$META_DIR/apt-manual"
  lsblk -f                         > "$META_DIR/lsblk.txt"
  cp -f /etc/fstab                   "$META_DIR/fstab"
  cp -f /etc/os-release              "$META_DIR/os-release"

  : > "$META_DIR/crontabs.txt"
  for u in root rafael; do
    printf '===== crontab -u %s =====\n' "$u" >> "$META_DIR/crontabs.txt"
    crontab -l -u "$u" 2>/dev/null           >> "$META_DIR/crontabs.txt" || echo "(none)" >> "$META_DIR/crontabs.txt"
  done

  # The ESP is NOT in the archive (--one-file-system). Its UUID is the
  # reference the Mint installer's fstab may need repairing against (§5.3.7).
  local esp
  esp="$(findmnt -no SOURCE /boot/efi 2>/dev/null || true)"
  {
    echo "kernel:      $(uname -r)"
    echo "borg:        $(borg --version)"
    echo "rclone:      $(rclone version 2>/dev/null | head -1 || echo 'not installed')"
    echo "esp_device:  ${esp:-unknown}"
    echo "esp_uuid:    $([ -n "$esp" ] && blkid -s UUID -o value "$esp" 2>/dev/null || echo unknown)"
    echo "root_uuid:   $(findmnt -no UUID / 2>/dev/null || echo unknown)"
    echo "borg_repo:   $BORG_REPO"
    echo "repo_id:     $(borg info --json "$BORG_REPO" 2>/dev/null | grep -o '"id": "[^"]*"' | head -1 | cut -d'"' -f4)"
    echo "generated:   $(date -Is)"
    echo
    echo "RESTORE NOTE: borg 1.2.x is required — borg 2's repo format cannot"
    echo "read this repo without a 'borg transfer' first (proposal §5.5)."
  } > "$META_DIR/versions.txt"
  say "restore metadata dumped to $META_DIR"
}

# ---- quiescing the databases -------------------------------------------------
# borg copies a live file as it finds it. A database engine writing during the
# copy yields an archive entry that is not a valid database, and borg says so
# ("file changed while we backed it up") with rc=1. Every container listed in
# QUIESCE_CONTAINERS is an M/IRIS engine, so an unquiesced run warns forever AND
# stores database files no restore could open.
#
# Restart is guaranteed by the EXIT trap main() installs: a borg failure, a
# die(), or a Ctrl-C still brings the engines back. Only containers THIS run
# stopped are restarted, so one that was already down stays down.
QUIESCED=()

alarm() { # $1 = title, $2 = body — same ntfy channel as minty-backup-watch
  # shellcheck source=/dev/null
  [ -r "$NTFY_ENV" ] && { set -a; . "$NTFY_ENV"; set +a; }
  if [ -z "${NTFY_TOPIC:-}" ]; then
    say "ALARM UNDELIVERABLE — NTFY_TOPIC unset (looked in $NTFY_ENV)"
    return 1
  fi
  curl -fsS --max-time 30 \
    -H "Title: $1" -H "Priority: urgent" -H "Tags: rotating_light,whale" \
    -d "$2" "${NTFY_SERVER:-https://ntfy.sh}/$NTFY_TOPIC" >/dev/null \
    && say "ntfy alarm pushed" || say "ntfy alarm FAILED to send"
}

quiesce_down() {
  [ -n "${QUIESCE_CONTAINERS// /}" ] || { say "quiesce: nothing configured — engines left running"; return 0; }
  command -v docker >/dev/null || die "QUIESCE_CONTAINERS set but docker is not installed."
  local c state
  # shellcheck disable=SC2086  # deliberate word splitting: space-separated list
  for c in $QUIESCE_CONTAINERS; do
    state="$(docker inspect -f '{{.State.Running}}' "$c" 2>/dev/null || echo missing)"
    case "$state" in
      true)
        say "quiesce: stopping $c"
        docker stop -t "$QUIESCE_TIMEOUT" "$c" >/dev/null \
          || die "quiesce: could not stop $c — refusing to archive a live database."
        QUIESCED+=("$c") ;;
      false)   say "quiesce: $c already stopped — left alone" ;;
      *)       say "quiesce: $c does not exist — skipped" ;;
    esac
  done
  [ "${#QUIESCED[@]}" -eq 0 ] || say "quiesce: ${#QUIESCED[@]} engine(s) down for the borg phase"
}

quiesce_up() {
  [ "${#QUIESCED[@]}" -gt 0 ] || return 0
  local c failed=()
  for c in "${QUIESCED[@]}"; do
    if docker start "$c" >/dev/null 2>&1; then
      say "quiesce: restarted $c"
    else
      say "quiesce: *** FAILED TO RESTART $c ***"
      failed+=("$c")
    fi
  done
  QUIESCED=()
  [ "${#failed[@]}" -eq 0 ] && return 0

  # This is the one failure here that leaves the machine WORSE than if the
  # backup had never run, so it alarms now instead of waiting for the morning
  # staleness check — which would not catch it anyway: the stamp is about the
  # backup, and the backup succeeded.
  alarm "minty-backup: container did not restart" \
        "Stopped for the backup and failed to restart on $(hostname): ${failed[*]}
Start them by hand:  docker start ${failed[*]}"
  return 1
}

# ---- borg phase --------------------------------------------------------------
# borg's exit codes are 0 = success, 1 = WARNING, 2+ = error. A warning is a
# real, complete archive with a note attached — "file changed while we backed it
# up" is the common one — and treating it as failure is how a good nightly run
# reports RED, skips its stamp, and never reaches prune. Only rc>=2 is failure.
borg_rc() { # $1 = rc, $2 = which borg command
  case "$1" in
    0) return 0 ;;
    1) say "borg $2: rc=1 WARNING — archive is complete; see the lines above"; return 0 ;;
    *) say "borg $2: rc=$1 ERROR"; return 1 ;;
  esac
}

phase_borg() {
  local archive="minty-{now:%Y-%m-%dT%H:%M}" rc=0
  say "borg create $archive"
  borg create --stats --show-rc \
    --compression "$BORG_COMPRESSION" \
    --one-file-system \
    "${BORG_EXCLUDES[@]}" \
    "$BORG_REPO::$archive" / || rc=$?
  borg_rc "$rc" create || return 1

  say "borg prune (${KEEP_DAILY}d/${KEEP_WEEKLY}w/${KEEP_MONTHLY}m)"
  rc=0
  borg prune --list --show-rc \
    --glob-archives 'minty-*' \
    --keep-daily="$KEEP_DAILY" \
    --keep-weekly="$KEEP_WEEKLY" \
    --keep-monthly="$KEEP_MONTHLY" \
    "$BORG_REPO" || rc=$?
  borg_rc "$rc" prune || return 1

  # Prune only marks segments unused. compact is what rewrites them, and
  # segment rewriting is the SMR-unfriendly pattern — weekly, not nightly.
  if [ "$(date +%u)" = "$COMPACT_DOW" ]; then
    say "borg compact (weekly)"
    local t0=$SECONDS
    rc=0
    borg compact --show-rc "$BORG_REPO" || rc=$?
    borg_rc "$rc" compact || return 1
    say "compact took $((SECONDS - t0))s  <-- record the FIRST one in proposal §4.3"
  fi
  return 0
}

# ---- cloud phase -------------------------------------------------------------
# rclone COPY, never sync: a sync is a mirror and propagates an accidental
# rm -rf offsite within 24 h (§11.5 item 3). Deletion protection comes from
# bucket versioning, or from CLOUD_BACKUP_DIR where the bucket has none.
phase_cloud() {
  [ -n "$CLOUD_REMOTE" ] || { say "cloud phase skipped (no remote)"; return 2; }

  local args=(copy --fast-list --transfers 4 --checkers 8 --stats-one-line --stats 5m)
  [ -n "$CLOUD_BACKUP_DIR" ] && args+=(--backup-dir "$CLOUD_BACKUP_DIR")
  while IFS= read -r pat; do
    [ -n "$pat" ] && args+=(--exclude "$pat")
  done <<< "$CLOUD_EXCLUDES"

  local rc=0 src dest
  while IFS= read -r src; do
    [ -n "$src" ] || continue
    if [ ! -e "$src" ]; then
      say "cloud: MISSING $src — curated subset is incomplete, phase RED"
      rc=1; continue
    fi
    dest="${CLOUD_REMOTE%/}/minty${src}"          # absolute path mirrored under minty/
    say "cloud: $src -> $dest"
    rclone "${args[@]}" "$src" "$dest" || rc=1
  done <<< "$CLOUD_PATHS"
  return "$rc"
}

stamp() { # $1 = stamp path, $2 = verdict line
  mkdir -p "$STAMP_DIR"; chmod 755 "$STAMP_DIR"
  {
    echo "generated: $(date -u +%Y-%m-%dT%H:%M:%SZ)"
    echo "host:      $(hostname)"
    echo "verdict:   green"
    echo "net:       $2"
    echo
    echo "Green-only anchor: a failed run refreshes NOTHING and this file ages."
    echo "Staleness IS the alarm — see minty-backup-watch."
  } > "$1"
  chmod 644 "$1"
}

trim_log() {
  [ -f "$LOG" ] || return 0
  [ "$(wc -l < "$LOG")" -gt "$LOG_KEEP_LINES" ] || return 0
  tail -n "$LOG_KEEP_LINES" "$LOG" > "$LOG.tmp" && mv "$LOG.tmp" "$LOG"
}

main() {
  echo "==================== $(date -Is) minty-backup ===================="
  preflight
  if [ "$PREFLIGHT_ONLY" -eq 1 ]; then
    say "PREFLIGHT ONLY — nothing written, nothing stamped"
    echo "==================== done $(date -Is) ===================="
    return 0
  fi

  if [ "$SYNC_DOCS_ONLY" -eq 1 ]; then
    sync_drive_docs
    say "SYNC-DOCS ONLY — no archive written, nothing stamped"
    echo "==================== done $(date -Is) ===================="
    return 0
  fi

  dump_meta
  sync_drive_docs

  # The trap is the guarantee, not the explicit call below it: die(), a borg
  # error, or a Ctrl-C must never leave the engines stopped.
  trap 'quiesce_up || true' EXIT INT TERM
  quiesce_down

  if phase_borg; then
    stamp "$STAMP_BORG" "borg create + prune$([ "$(date +%u)" = "$COMPACT_DOW" ] && echo ' + compact') on $BORG_REPO"
    say "borg phase GREEN"
  else
    # Staleness alone does NOT cover this. A single failed run leaves a stamp
    # only ~30 h old at the 05:35 watcher — inside its 36 h limit — so the
    # failure went unreported that morning, and if the NEXT night succeeded it
    # was never reported at all. Alarm now, while it is still last night.
    say "borg phase RED — STAMP.borg NOT refreshed"
    alarm "minty BACKUP FAILED — borg phase RED" \
"$(hostname) · $(date '+%Y-%m-%d %H:%M')
The nightly borg phase failed. STAMP.borg was NOT refreshed, so the newest
archive is still whatever the last successful run wrote.

Last 40 log lines: sudo tail -40 $LOG
Status:            minty-backup-status
Verify drive+repo: sudo minty-backup-check" || true
  fi

  # Restart as soon as borg is done — the cloud phase reads only the curated
  # subset and does not need the engines down for it.
  quiesce_up || true
  trap - EXIT INT TERM

  local crc=0
  phase_cloud || crc=$?
  case "$crc" in
    0) stamp "$STAMP_CLOUD" "rclone copy of the curated subset to $CLOUD_REMOTE"
       say "cloud phase GREEN" ;;
    2) say "cloud phase not configured — STAMP.rclone intentionally absent" ;;
    *) say "cloud phase RED — STAMP.rclone NOT refreshed"
       # Dormant until D2 closes, but the same silent hole as borg-RED above:
       # wire it now rather than rediscover it when the cloud layer lands.
       alarm "minty BACKUP — cloud phase RED" \
"$(hostname) · $(date '+%Y-%m-%d %H:%M')
The offsite copy failed; the local borg archive is unaffected.

Last 40 log lines: sudo tail -40 $LOG" || true ;;
  esac

  trim_log
  echo "==================== done $(date -Is) ===================="
}

if [ "$PREFLIGHT_ONLY" -eq 1 ]; then
  # Interactive: talk to the terminal, and DO surface a real exit code so the
  # guards are testable ("--preflight with the drive unplugged exits non-zero").
  main
else
  # Cron: always exit 0 — the stamp is the channel, not the exit code. main
  # runs in a SUBSHELL so that die()'s exit aborts the run without escaping
  # past `|| true` and turning a handled abort into a cron-level failure.
  #
  # An unwritable log must not swallow the run silently: that would be the same
  # class of defect as everything else guarded against here. Fall through to
  # stderr, which cron does deliver.
  if { : >>"$LOG"; } 2>/dev/null; then
    ( main ) >>"$LOG" 2>&1 || true
  else
    echo "minty-backup: WARNING — $LOG is not writable; logging to stderr" >&2
    ( main ) || true
  fi
  exit 0
fi
