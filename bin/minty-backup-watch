#!/usr/bin/env bash
# =============================================================================
#  minty-backup-watch
#  Version: 1.2.0
#  Target:  minty — Linux Mint 22.3 / Ubuntu 24.04, bash 5.x, run as rafael
#
#  Purpose
#  The alarm half of the minty backup design. minty-backup and
#  minty-backup-check stamp GREEN ONLY, so staleness is the alarm — this is
#  the thing that reads the stamps and pushes ntfy when one has aged out.
#
#  Canon: ~/projects/minty/docs/minty-backup-proposal.md §4.4 and §7.
#
#  Design
#  Standalone rather than a few lines inside the org's local-watcher-cron.sh
#  (proposal §7 / decision D5): backing up minty is a machine concern, not
#  vista-forge business, and the org watcher git-commits its STAMP to a repo —
#  wiring machine disaster recovery into that path would couple recovery to a
#  GitHub PAT. Reusing NTFY_TOPIC from auth.env for the alarm IS sanctioned;
#  hosting the facility inside the org is not.
#
#  What it checks
#    STAMP.borg    <= 36 h   the nightly borg run                     (required)
#    STAMP.rclone  <= 36 h   the offsite copy   (only if a remote is configured)
#    STAMP.check   <= 10 d   the weekly verification calendar         (required)
#
#  A missing stamp is treated as stale, not as "not applicable" — the one
#  exception is STAMP.rclone while CLOUD_REMOTE is empty (open decision D2),
#  which is a deliberate not-yet-implemented state rather than a failure.
#
#  STAMP.borg also gets a SECOND, tighter test (v1.2.0): it must be newer than
#  the most recent scheduled run — i.e. the last $BACKUP_HOUR:00 boundary. The
#  36 h limit exists to tolerate a late or slow run, but it cannot answer "did
#  LAST NIGHT succeed?" As first measured on the 23:00 schedule: a run failing
#  at 23:00 left a ~30 h-old stamp at the then-05:35 watcher, comfortably inside
#  the limit. Before v1.2.0 that meant a single failed backup produced no alarm
#  on the morning after, and none ever if the next night succeeded; worse, the
#  v1.1.0 green digest read the fresh-enough stamp and published "backed up ✓"
#  over it. The boundary test is what makes the digest's claim true.
#
#  ⚠️ BACKUP_HOUR MUST TRACK THE REAL CRON. It defaults to 0 (the 00:00 slot
#  since 2026-08-11) and is overridable from $CONFIG_PUB. It is the ONLY link
#  between this watcher and minty-backup's actual schedule, and nothing gates
#  the pair: set it in the SAME action as editing the root crontab. Measured
#  2026-08-11 — the two were briefly out of step in BOTH directions during the
#  move, and each mismatch silently mis-reports a healthy night as a failed one
#  (or the reverse). Verify with:
#      sudo crontab -l | awk '/minty-backup$/{print $2}'   # must equal BACKUP_HOUR
#
#  Quiet on green means NON-INTERRUPTING, not absent (amended 2026-08-11,
#  following the vista-ready 06:15 digest precedent in the ntfy-alarm-channel
#  skill): a green day publishes ONE digest at ntfy priority `min` — silent,
#  in-app only — so the operator gets contrast and phone-side absence
#  detection instead of an unbroken silence that looks identical to a dead
#  watcher. A red still pages at `high`. Set GREEN_DIGEST=0 (here or in
#  $CONFIG_PUB) to go back to red-only.
#
#  Use
#    minty-backup-watch            check; digest on green, alarm if stale
#    minty-backup-watch --status   print ages, never publish
#    minty-backup-watch --test     send one test alarm and exit
#
#  Schedule (user crontab — `crontab -e`):
#    15 0 * * *  /home/rafael/scripts/bin/minty-backup-watch
#  00:15 since 2026-08-11 (was 05:35): immediately after the 00:00 borg run, at
#  the head of the operator's 00:00-05:00 window, so the backup's verdict is the
#  first thing the night reports rather than the last.
# =============================================================================
set -euo pipefail

CONFIG_PUB="${MINTY_BACKUP_WATCH_CONFIG:-$HOME/.config/minty-backup-watch.env}"
NTFY_ENV="${VISTA_FORGE_AUTH_ENV:-$HOME/data/vista-forge/auth.env}"

STAMP_DIR="/var/lib/minty-backup"
LOG="$HOME/data/minty-backup/watch.log"
BACKUP_LOG="/var/log/minty-backup.log"   # root-owned but world-readable; the
                                         # green digest quotes its last run
MAX_HOURS_BORG=36
MAX_HOURS_CLOUD=36
MAX_DAYS_CHECK=10
BACKUP_HOUR=0            # the hour minty-backup is scheduled in ROOT's crontab
                         # (00:00 since 2026-08-11); STAMP.borg must be newer
                         # than the last one of these. Keep in lockstep with the
                         # real cron — see the warning in the header block.
GREEN_DIGEST=1           # 1 = publish a silent (priority min) digest on a green
                         # day; 0 = red-only, the pre-1.1.0 behaviour.
CLOUD_ENABLED=0          # set to 1 here (or in $CONFIG_PUB) once D2 closes and
                         # minty-backup has a CLOUD_REMOTE — then a stale
                         # offsite copy alarms instead of being ignored.

# shellcheck source=/dev/null
[ -r "$CONFIG_PUB" ] && { set -a; . "$CONFIG_PUB"; set +a; }
# The CALLER's NTFY_* must win over auth.env — including set-to-empty, which is
# the deliberate-suppression case. Sourcing auth.env unguarded stomps a
# rehearsal's `NTFY_TOPIC=` and pages the operator with a false alarm (measured
# in the org 2026-08-10; see the ntfy-alarm-channel skill). Capture, source,
# restore. This matters more now that a green day publishes too.
_ntfy_topic_set="${NTFY_TOPIC+x}";   _ntfy_topic_val="${NTFY_TOPIC:-}"
_ntfy_server_set="${NTFY_SERVER+x}"; _ntfy_server_val="${NTFY_SERVER:-}"
# shellcheck source=/dev/null
[ -r "$NTFY_ENV" ] && { set -a; . "$NTFY_ENV"; set +a; }
[ -n "$_ntfy_topic_set" ]  && NTFY_TOPIC="$_ntfy_topic_val"
[ -n "$_ntfy_server_set" ] && NTFY_SERVER="$_ntfy_server_val"

MODE="check"
case "${1:-}" in
  -h|--help) sed -n '2,40p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
  --status)  MODE="status" ;;
  --test)    MODE="test" ;;
esac

STALE=()

publish() { # $1 = priority, $2 = tags, $3 = title, $4 = body
  if [ -z "${NTFY_TOPIC:-}" ]; then
    echo "  NTFY UNDELIVERABLE — NTFY_TOPIC unset (looked in $NTFY_ENV)" >&2
    return 1
  fi
  curl -fsS --max-time 30 \
    -H "Title: $3" -H "Priority: $1" -H "Tags: $2" \
    -d "$4" "${NTFY_SERVER:-https://ntfy.sh}/$NTFY_TOPIC" >/dev/null
}

alarm() { # $1 = title, $2 = body — a red interrupts the operator
  publish high "rotating_light,floppy_disk" "$1" "$2"
}

# One line of detail about the last completed borg run, parsed from the backup
# log the same way minty-backup-status does. Best-effort: the digest still goes
# out (with the anchor ages, which come from the stamps) if the log is gone.
last_run_line() {
  local block archive files dedup
  [ -r "$BACKUP_LOG" ] || { printf 'run detail unavailable (%s unreadable)' "$BACKUP_LOG"; return 0; }
  block="$(awk '/^=+ .* minty-backup =+$/ && !/done/ {buf=""} {buf=buf $0 "\n"} END{printf "%s", buf}' "$BACKUP_LOG")"
  archive="$(printf '%s' "$block" | sed -n 's/^Archive name: *//p' | tail -1)"
  files="$(printf '%s'  "$block" | sed -n 's/^Number of files: *//p' | tail -1)"
  dedup="$(printf '%s'  "$block" | awk '/^This archive:/{print $(NF-1)" "$NF}' | tail -1)"
  printf '%s' "${archive:-archive name unknown}"
  [ -n "$files" ] && printf ' · %s files' "$files"
  [ -n "$dedup" ] && printf ' · %s new' "$dedup"
  return 0
}

age_hours() { # $1 = file; -1 if absent
  [ -f "$1" ] || { echo -1; return; }
  echo $(( ( $(date +%s) - $(stat -c %Y "$1") ) / 3600 ))
}

fmt_age() { local h=$1; [ "$h" -lt 0 ] && { echo "ABSENT"; return; }; echo "${h}h"; }

# Epoch of the most recent scheduled backup start — today's if we are already
# past it, otherwise yesterday's. A stamp older than this means the run that
# was supposed to happen did not leave a green mark.
last_scheduled_epoch() {
  local today; today="$(date -d "today ${BACKUP_HOUR}:00" +%s)"
  if [ "$(date +%s)" -ge "$today" ]; then echo "$today"
  else date -d "yesterday ${BACKUP_HOUR}:00" +%s; fi
}

examine() { # $1 = stamp name, $2 = max hours, $3 = human cadence
  local f="$STAMP_DIR/$1" h; h="$(age_hours "$f")"
  printf '  %-14s %-8s (limit %sh — %s)\n' "$1" "$(fmt_age "$h")" "$2" "$3"
  [ "$MODE" = "status" ] && return 0
  if [ "$h" -lt 0 ]; then
    STALE+=("$1 is ABSENT — the $3 has never succeeded, or the stamp was removed")
  elif [ "$h" -gt "$2" ]; then
    STALE+=("$1 is ${h}h old (limit ${2}h) — the $3 has not succeeded since $(date -d "@$(stat -c %Y "$f")" -Is)")
  fi
}

main() {
  echo "==================== $(date -Is) minty-backup-watch ===================="

  if [ "$MODE" = "test" ]; then
    alarm "minty backup watch — TEST" "test alarm from $(hostname) $(date -Is)" \
      && echo "  test alarm sent" || echo "  test alarm FAILED"
    return 0
  fi

  if [ ! -d "$STAMP_DIR" ]; then
    # Before tracker step 3 this is the expected state, and alarming daily
    # about it would train the operator to ignore the channel.
    echo "  $STAMP_DIR does not exist — backup not yet implemented; nothing to watch."
    return 0
  fi

  local before_borg=${#STALE[@]} sched
  examine STAMP.borg  "$MAX_HOURS_BORG"  "nightly borg run"
  # Only if the age test passed — otherwise this just restates it.
  if [ "$MODE" != "status" ] && [ "${#STALE[@]}" -eq "$before_borg" ] \
     && [ -f "$STAMP_DIR/STAMP.borg" ]; then
    sched="$(last_scheduled_epoch)"
    if [ "$(stat -c %Y "$STAMP_DIR/STAMP.borg")" -lt "$sched" ]; then
      STALE+=("STAMP.borg predates the $(printf '%02d:00' "$BACKUP_HOUR") run of $(date -d "@$sched" '+%Y-%m-%d') — LAST NIGHT'S BACKUP DID NOT SUCCEED (the stamp is still fresh enough to pass the ${MAX_HOURS_BORG}h age limit, which is why this test exists)")
    fi
  fi
  if [ "$CLOUD_ENABLED" = "1" ]; then
    examine STAMP.rclone "$MAX_HOURS_CLOUD" "nightly offsite copy"
  else
    echo "  STAMP.rclone   skipped  (cloud layer not enabled — open decision D2)"
  fi
  examine STAMP.check "$(( MAX_DAYS_CHECK * 24 ))" "weekly verification calendar"

  [ "$MODE" = "status" ] && return 0

  if [ "${#STALE[@]}" -eq 0 ]; then
    echo "  all anchors fresh"
    if [ "$GREEN_DIGEST" = "1" ]; then
      publish min "floppy_disk,white_check_mark" "minty backed up ✓" \
"$(hostname) · $(date '+%Y-%m-%d %H:%M')
$(last_run_line)
borg $(fmt_age "$(age_hours "$STAMP_DIR/STAMP.borg")") ago · verification $(fmt_age "$(age_hours "$STAMP_DIR/STAMP.check")") ago

For more detail, run minty-backup-status
To verify the drive and repo, run sudo minty-backup-check" \
        && echo "  green digest published (priority min — silent)" \
        || echo "  green digest FAILED to send"
    else
      echo "  green digest disabled (GREEN_DIGEST=0) — quiet"
    fi
  else
    echo "  ${#STALE[@]} STALE anchor(s):"
    printf '    %s\n' "${STALE[@]}"
    alarm "minty BACKUP STALE (${#STALE[@]})" \
      "$(hostname) $(date -Is)
$(printf '%s\n' "${STALE[@]}")
Check: sudo tail -40 /var/log/minty-backup.log" \
      && echo "  ntfy alarm pushed" || echo "  ntfy alarm FAILED to send"
  fi
  echo "==================== done $(date -Is) ===================="
}

mkdir -p "$(dirname "$LOG")"
if [ "$MODE" = "status" ] || [ -t 1 ]; then
  main || true
else
  main >>"$LOG" 2>&1 || true
fi
exit 0
