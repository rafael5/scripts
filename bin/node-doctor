#!/usr/bin/env bash
# node-doctor — machine-wide Node consistency gate.
#
# Asserts that the runtime, nvm, every Node package, and every config on this
# box agree with ~/scripts/node-policy.env. Exits non-zero on any drift.
#
#   node-doctor              full report
#   node-doctor --quiet      only failures (for cron)
#   node-doctor --self-test  plant each violation, prove every check can RED
#   node-doctor --list       print every discovered package dir (one per line)
#
# Design notes (house rules it is built to satisfy):
#   * Discovery is LIVE (find), never a checked-in registry -- a new repo is
#     covered the day it appears, so the inventory cannot drift.
#   * FAILS CLOSED: a missing input is a failure, never a silent skip. Every
#     skip that does happen is printed.
#   * RED-PROVED: --self-test plants a violation for each package check and
#     asserts the check reports it. A gate that has never failed is
#     indistinguishable from one that cannot fail.
#   * Offline: no network at any point.
set -uo pipefail

POLICY="${NODE_POLICY:-$HOME/scripts/node-policy.env}"
QUIET=0; SELFTEST=0; LIST=0
for a in "$@"; do
  case "$a" in
    --quiet) QUIET=1 ;;
    --self-test) SELFTEST=1 ;;
    --list) LIST=1 ;;
    -h|--help) sed -n '2,12p' "$0"; exit 0 ;;
    *) echo "node-doctor: unknown option: $a" >&2; exit 64 ;;
  esac
done

if [ ! -r "$POLICY" ]; then
  echo "node-doctor: FAIL  policy file not readable: $POLICY" >&2
  exit 1
fi
# shellcheck source=/dev/null
. "$POLICY"
: "${NODE_MAJOR:?node-doctor: NODE_MAJOR unset in $POLICY}"

FAILS=0; CHECKS=0; SKIPS=0
red()  { FAILS=$((FAILS+1)); printf '  FAIL  %s\n' "$*"; }
ok()   { [ "$QUIET" -eq 1 ] || printf '  ok    %s\n' "$*"; }
skip() { SKIPS=$((SKIPS+1)); printf '  SKIP  %s\n' "$*"; }
head_() { [ "$QUIET" -eq 1 ] || printf '\n%s\n' "$*"; }
c() { CHECKS=$((CHECKS+1)); }

# --------------------------------------------------------------------------
# Package discovery. Prints one absolute package dir per line.
# --------------------------------------------------------------------------
discover() {
  local root prune_expr=() d
  for d in ${NODE_SCAN_PRUNE:-node_modules .git}; do
    prune_expr+=( -name "$d" -o )
  done
  for root in "$@"; do
    [ -d "$root" ] || continue
    find "$root" -maxdepth 4 \( "${prune_expr[@]:0:${#prune_expr[@]}-1}" \) -prune \
      -o -name package.json -print 2>/dev/null
  done | while read -r pj; do dirname "$pj"; done | sort -u
}

# Nearest .node-version walking up from $1 to $HOME. Echoes "value<TAB>owner".
nearest_pin() {
  local p="$1"
  while [ "$p" != "/" ] && [ "$p" != "$HOME" ]; do
    if [ -f "$p/.node-version" ]; then printf '%s\t%s\n' "$(cat "$p/.node-version")" "$p"; return 0; fi
    p=$(dirname "$p")
  done
  return 1
}

# Nearest .envrc containing `use nvm` (direnv DOES walk up, so inherited is OK).
nearest_envrc_nvm() {
  local p="$1"
  while [ "$p" != "/" ] && [ "$p" != "$HOME" ]; do
    if [ -f "$p/.envrc" ] && grep -q 'use nvm\|use_nvm' "$p/.envrc"; then echo "$p"; return 0; fi
    p=$(dirname "$p")
  done
  return 1
}

# Is $1 inside a git repo this machine owns? Foreign checkouts are reported
# but never failed: we must not dirty someone else's tree to satisfy our policy.
is_foreign() {
  local url e
  # An explicit operator decision overrides the remote: these are ours to change.
  for e in ${NODE_ENFORCE_ANYWAY:-}; do
    case "$1" in "$e"|"$e"/*) return 1 ;; esac
  done
  url=$(git -C "$1" remote get-url origin 2>/dev/null) || return 1   # no repo => ours
  printf '%s' "$url" | grep -qE "${NODE_OWN_REMOTE_PATTERN:-.}" && return 1
  printf '%s' "$url"
}

# --------------------------------------------------------------------------
# Per-package checks. Used by the real run AND by --self-test, which is what
# makes the red-proof meaningful: the self-test exercises this exact code.
# Echoes one "CODE<TAB>message" line per violation; silent when clean.
# --------------------------------------------------------------------------
check_package() {
  local d="$1" rel="${1/$HOME/\~}" pin owner en
  if pin_line=$(nearest_pin "$d"); then
    pin=${pin_line%%$'\t'*}; owner=${pin_line#*$'\t'}
    [ "$pin" = "$NODE_MAJOR" ] || printf 'PIN\t%s: .node-version is "%s", policy is "%s" (from %s)\n' "$rel" "$pin" "$NODE_MAJOR" "${owner/$HOME/\~}"
  else
    printf 'PIN\t%s: no .node-version anywhere up to $HOME\n' "$rel"
  fi

  en=$(python3 -c 'import json,sys;print(json.load(open(sys.argv[1])).get("engines",{}).get("node",""))' "$d/package.json" 2>/dev/null)
  if [ -z "$en" ]; then
    printf 'ENGINES\t%s: package.json has no engines.node (policy: ">=%s")\n' "$rel" "$NODE_MAJOR"
  elif [ "$en" != ">=$NODE_MAJOR" ]; then
    printf 'ENGINES\t%s: engines.node is "%s", policy is ">=%s"\n' "$rel" "$en" "$NODE_MAJOR"
  fi

  # npm reads the .npmrc in the package dir; it does NOT walk up. So this one
  # must be local, unlike the pin and the .envrc.
  if ! grep -qs '^engine-strict *= *true' "$d/.npmrc"; then
    printf 'NPMRC\t%s: no local .npmrc with engine-strict=true (a wrong Node would warn, not fail)\n' "$rel"
  fi

  nearest_envrc_nvm "$d" >/dev/null || \
    printf 'ENVRC\t%s: no .envrc with `use nvm` here or above (no direnv auto-switch)\n' "$rel"

  if [ -f "$d/Makefile" ] && ! grep -qs 'node-pin-check\|\.node-version' "$d/Makefile"; then
    printf 'GATE\t%s: Makefile has no Node pin check (gate can run on the wrong Node)\n' "$rel"
  fi
}

if [ "$LIST" -eq 1 ]; then
  # shellcheck disable=SC2086
  discover $NODE_SCAN_ROOTS
  exit 0
fi

# ==========================================================================
# --self-test : plant one violation of each kind, assert the check reports it.
# ==========================================================================
if [ "$SELFTEST" -eq 1 ]; then
  echo "node-doctor --self-test  (policy NODE_MAJOR=$NODE_MAJOR)"
  tmp=$(mktemp -d); trap 'rm -rf "$tmp"' EXIT
  st_fail=0
  plant() { # name, code-expected, setup-fn
    local name="$1" want="$2" dir="$tmp/$1"; shift 2
    mkdir -p "$dir"; ( cd "$dir" && "$@" )
    local out; out=$(HOME="$tmp" check_package "$dir")
    if printf '%s' "$out" | grep -q "^$want"$'\t'; then
      printf '  ok    %-10s planted -> %s reported\n' "$name" "$want"
    else
      printf '  FAIL  %-10s planted but %s NOT reported (check cannot red)\n' "$name" "$want"
      st_fail=$((st_fail+1))
    fi
  }
  good() { # a fully compliant package, used as the negative control
    printf '%s\n' "$NODE_MAJOR" > .node-version
    printf '{"name":"x","engines":{"node":">=%s"}}\n' "$NODE_MAJOR" > package.json
    printf 'engine-strict=true\n' > .npmrc
    printf 'use nvm\n' > .envrc
  }
  plant pin      PIN      sh -c 'good_pin() { :; }; printf "18\n" > .node-version; printf "{\"engines\":{\"node\":\">='"$NODE_MAJOR"'\"}}" > package.json; printf "engine-strict=true\n" > .npmrc; printf "use nvm\n" > .envrc'
  plant engines  ENGINES  sh -c 'printf "'"$NODE_MAJOR"'\n" > .node-version; printf "{\"engines\":{\"node\":\">=22\"}}" > package.json; printf "engine-strict=true\n" > .npmrc; printf "use nvm\n" > .envrc'
  plant noeng    ENGINES  sh -c 'printf "'"$NODE_MAJOR"'\n" > .node-version; printf "{}" > package.json; printf "engine-strict=true\n" > .npmrc; printf "use nvm\n" > .envrc'
  plant npmrc    NPMRC    sh -c 'printf "'"$NODE_MAJOR"'\n" > .node-version; printf "{\"engines\":{\"node\":\">='"$NODE_MAJOR"'\"}}" > package.json; printf "use nvm\n" > .envrc'
  plant envrc    ENVRC    sh -c 'printf "'"$NODE_MAJOR"'\n" > .node-version; printf "{\"engines\":{\"node\":\">='"$NODE_MAJOR"'\"}}" > package.json; printf "engine-strict=true\n" > .npmrc'
  plant gate     GATE     sh -c 'printf "'"$NODE_MAJOR"'\n" > .node-version; printf "{\"engines\":{\"node\":\">='"$NODE_MAJOR"'\"}}" > package.json; printf "engine-strict=true\n" > .npmrc; printf "use nvm\n" > .envrc; printf "all:\n\t@true\n" > Makefile'

  # Negative control: a compliant package must produce NOTHING. Without this a
  # check that always fires would pass every plant above.
  ctl="$tmp/clean"; mkdir -p "$ctl"
  ( cd "$ctl" && printf '%s\n' "$NODE_MAJOR" > .node-version \
      && printf '{"engines":{"node":">=%s"}}' "$NODE_MAJOR" > package.json \
      && printf 'engine-strict=true\n' > .npmrc && printf 'use nvm\n' > .envrc )
  ctl_out=$(HOME="$tmp" check_package "$ctl")
  if [ -z "$ctl_out" ]; then
    printf '  ok    %-10s compliant package reports nothing\n' "control"
  else
    printf '  FAIL  %-10s compliant package reported: %s\n' "control" "$ctl_out"; st_fail=$((st_fail+1))
  fi

  echo
  if [ "$st_fail" -eq 0 ]; then echo "self-test: all checks proved capable of failing ✓"; exit 0
  else echo "self-test: $st_fail check(s) could not red — they are stubs"; exit 1; fi
fi

# ==========================================================================
# Real run
# ==========================================================================
[ "$QUIET" -eq 1 ] || echo "node-doctor  (policy: Node $NODE_MAJOR, from ${POLICY/$HOME/\~})"

head_ "runtime"
c; nodes=$(type -a node 2>/dev/null | grep -c 'is /' || true)
if [ "${nodes:-0}" -eq 0 ]; then red "no node on PATH"
elif [ "$nodes" -gt 1 ]; then red "$nodes copies of node on PATH: $(type -a node | awk '{print $3}' | tr '\n' ' ')"
else ok "exactly one node on PATH: $(command -v node)"; fi

c; have=$(node -v 2>/dev/null | sed 's/^v//; s/\..*//')
if [ -z "$have" ]; then red "cannot determine running node version"
elif [ "$have" != "$NODE_MAJOR" ]; then red "running Node $have, policy is $NODE_MAJOR"
else ok "running Node $(node -v)"; fi

c; if command -v dpkg >/dev/null 2>&1; then
  apt_n=$(dpkg -l 2>/dev/null | awk '/^ii/{print $2}' | grep -cE '^(nodejs|npm|libnode)' || true)
  if [ "${apt_n:-0}" -gt 0 ]; then red "$apt_n apt Node packages installed (apt Node is unpinnable; use nvm)"
  else ok "no apt Node packages installed"; fi
else skip "dpkg absent — cannot check for apt Node packages"; fi

c; if [ -s "${NVM_DIR:-$HOME/.nvm}/nvm.sh" ]; then
  def=$( . "${NVM_DIR:-$HOME/.nvm}/nvm.sh" >/dev/null 2>&1; nvm_version default 2>/dev/null )
  def_major=$(printf '%s' "$def" | sed 's/^v//; s/\..*//')
  if [ "$def_major" != "$NODE_MAJOR" ]; then red "nvm default alias -> $def (major $def_major), policy is $NODE_MAJOR"
  else ok "nvm default alias -> $def"; fi
else skip "nvm not found — cannot check the default alias"; fi

head_ "configs (no absolute version paths)"
c; hits=$(grep -rlE '\.nvm/versions/node/v[0-9]+' \
      "$HOME/.claude.json" "$HOME/scripts/bin" "$HOME/.config/systemd" "$HOME/.bashrc" "$HOME/.profile" \
      2>/dev/null | grep -v '/shell-snapshots/' || true)
if [ -n "$hits" ]; then
  red "absolute .nvm version path(s) — these break on every bump:"
  printf '%s\n' "$hits" | sed "s|$HOME|~|; s/^/          /"
else ok "no absolute .nvm/versions/node/vX paths in configs or scripts"; fi

head_ "packages"
# shellcheck disable=SC2086
pkgs=$(discover $NODE_SCAN_ROOTS)
if [ -z "$pkgs" ]; then red "discovery found no packages under: $NODE_SCAN_ROOTS"; fi
npkg=0; nforeign=0
while read -r d; do
  [ -n "$d" ] || continue
  npkg=$((npkg+1)); c
  out=$(check_package "$d")
  if furl=$(is_foreign "$d"); then
    nforeign=$((nforeign+1))
    if [ -n "$out" ]; then
      printf '  FOREIGN %s (%s)\n' "${d/$HOME/\~}" "$furl"
      while IFS=$'\t' read -r code msg; do printf '          would-be [%s] %s\n' "$code" "${msg#*: }"; done <<< "$out"
    else ok "${d/$HOME/\~} (foreign, compliant)"; fi
  elif [ -n "$out" ]; then
    while IFS=$'\t' read -r code msg; do red "[$code] $msg"; done <<< "$out"
  else ok "${d/$HOME/\~}"; fi
done <<< "$pkgs"
[ "$QUIET" -eq 1 ] || echo "  ($npkg packages discovered ($nforeign foreign, reported not enforced) under $(echo $NODE_SCAN_ROOTS | sed "s|$HOME|~|g"))"

head_ "lifecycle"
today=$(date +%F)
c; if [ -n "${NODE_NEXT_MAJOR_LTS_DATE:-}" ] && [ "$today" \> "$NODE_NEXT_MAJOR_LTS_DATE" ]; then
     red "Node ${NODE_NEXT_MAJOR:-?} reached Active LTS on $NODE_NEXT_MAJOR_LTS_DATE and NODE_MAJOR is still $NODE_MAJOR — run: node-bump ${NODE_NEXT_MAJOR:-?}"
   else ok "next major (${NODE_NEXT_MAJOR:-?}) not yet due — Active LTS ${NODE_NEXT_MAJOR_LTS_DATE:-unset}"; fi

echo
if [ "$SKIPS" -gt 0 ]; then echo "$SKIPS check(s) SKIPPED — see above (a skip is not a pass)"; fi
if [ "$FAILS" -eq 0 ]; then echo "node-doctor: $CHECKS checks, all consistent with Node $NODE_MAJOR ✓"; exit 0
else echo "node-doctor: $FAILS failure(s) across $CHECKS checks"; exit 1; fi
