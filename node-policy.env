# ~/scripts/node-policy.env — machine-wide Node version policy.
#
# THE major is declared here, once. Every repo pins only the MAJOR in its
# .node-version and floats within it, so a patch/minor release is picked up by
# `nvm install` + direnv with zero repo edits. Nothing anywhere may name a full
# x.y.z version -- that is the failure this file exists to prevent.
#
# Read by:  node-doctor (enforces), node-bump (rewrites), ~/scripts/machine-setup.md
# Change NODE_MAJOR only via `node-bump <major>`, which rehearses every repo's
# gate on the new major BEFORE switching.

# The Node major every repo on this machine runs.
NODE_MAJOR=24

# End of life for that major (Active LTS window). Informational; node-doctor
# warns once the date is within 90 days so a bump is never a surprise.
NODE_MAJOR_EOL=2028-04-30

# The next major to move to, and the date it reaches Active LTS. node-doctor
# reports when that date has passed and NODE_MAJOR has not moved.
NODE_NEXT_MAJOR=26
NODE_NEXT_MAJOR_LTS_DATE=2026-10-27

# Trees node-doctor discovers packages in (space separated, ~ expanded).
# ~/gzb is a set of clones of someone else's product repos (georgzurbonsen).
# Only b4p-vscode is listed: it is a CONSUMER repo of the b4p documentation
# artifacts, not primary development of the b4p product, so it is ours to
# change. b4p-apps and the rest are deliberately out of scope entirely --
# not "foreign and reported", just not scanned.
NODE_SCAN_ROOTS="$HOME/projects $HOME/vista-forge $HOME/gzb/b4p-vscode"

# Directory names never descended into during discovery.
NODE_SCAN_PRUNE="node_modules .git archive dist build .venv vendor out coverage"

# Git remotes whose repos this machine OWNS and may therefore modify. A
# discovered package whose repo belongs to anyone else is reported as FOREIGN:
# visible (so a stale pin is never invisible) but never a failure, because
# fixing it would dirty someone else's checkout and conflict on every pull.
NODE_OWN_REMOTE_PATTERN='(github\.com[:/](rafael5|vista-forge)/|^$)'

# Paths ENFORCED even though their git remote is foreign, because they are ours
# to modify by explicit decision. One line per path, space separated. Keep this
# short and justified: every entry is a promise that changing the tree there
# will not conflict with an upstream we do not control.
#   ~/gzb/b4p-vscode -- consumer of b4p doc artifacts, not b4p product source
#                       (operator decision, 2026-08-31)
NODE_ENFORCE_ANYWAY="$HOME/gzb/b4p-vscode"
